      "source_tool_call_id": "bootstrap"
    },
    {
      "step_id": "s1_enter_id",
      "tool": "type_text",
      "target_id": "member_id_field",
      "arguments": {
        "mode": "replace",
        "text": {
          "source": "input",
          "path": "/member_id"
        }
      },
      "postconditions": [
        {
          "kind": "value_equals",
          "target_id": "member_id_field",
          "expected": {
            "source": "input",
            "path": "/member_id"
          }
        }
      ],
      "source_tool_call_id": "call_001"
    },
    {
      "step_id": "s2_search",
      "tool": "click",
      "target_id": "search_button",
      "arguments": {},
      "postconditions": [
        {
          "kind": "matches_schema",
          "target_id": "member_result",
          "property": "text",
          "schema": {
            "type": "string",
            "pattern": "^Member .+ \\| [0-9]+\\.[0-9]{2}$"
          }
        }
      ],
      "source_tool_call_id": "call_002"
    },
    {
      "step_id": "s3_extract",
      "tool": "extract_data",
      "arguments": {
        "fields": [
          {
            "name": "member_summary",
            "target_id": "member_result",
            "property": "text",
            "output_type": "string"
          }
        ]
      },
      "postconditions": [
        {
          "kind": "field_extracted",
          "field": "member_summary"
        }
      ],
      "source_tool_call_id": "call_003"
    }
  ],
  "output_mapping": {
    "member_id": {
      "source": "input",
      "path": "/member_id"
    },
    "member_summary": {
