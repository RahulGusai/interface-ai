{
  "example_only": true,
  "schema_version": "capability-artifact/1",
  "artifact_id": "art_member_lookup_v1",
  "capability_id": "cap_member_lookup",
  "version": 1,
  "name": "Look up a member",
  "tool_contract_version": "browser-tools/1",
  "source_discovery_run_id": "run_discovery_001",
  "created_at": "2026-10-06T04:00:13.000Z",
  "environment": {
    "application_id": "synthetic-member-desk",
    "adapter_kind": "browser",
    "start_url": "http://127.0.0.1:4300/",
