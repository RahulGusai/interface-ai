    "required": [
      "member_id",
      "member_summary"
    ],
    "additionalProperties": false,
    "properties": {
      "member_id": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "member_summary": {
        "type": "string",
        "pattern": "^Member .+ \\| [0-9]+\\.[0-9]{2}$"
      }
    }
  },
  "targets": {
    "page_heading": {
      "strategy": "semantic",
      "frame_path": [],
      "role": "heading",
      "required_matches": 1,
      "name": "Member desk — synthetic data",
      "match": "exact"
    },
    "member_id_field": {
      "strategy": "semantic",
      "frame_path": [],
      "role": "textbox",
      "required_matches": 1,
      "name": "Member ID",
      "match": "exact"
    },
    "search_button": {
      "strategy": "semantic",
      "frame_path": [],
      "role": "button",
      "required_matches": 1,
      "name": "Search",
      "match": "exact"
    },
    "member_result": {
      "strategy": "semantic",
      "frame_path": [],
      "role": "status",
      "required_matches": 1
    }
  },
  "steps": [
    {
      "step_id": "s0_open",
      "tool": "navigate",
      "arguments": {
        "url": "http://127.0.0.1:4300/"
      },
      "postconditions": [
