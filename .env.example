# Server-side only. Copy to ignored .env; never put credentials in browser config.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
INTERFACE_ENV=local
INTERFACE_DB_PATH=data/interface-ai.sqlite3
INTERFACE_CORS_ORIGINS=["http://localhost:8080"]
# Absolute executable path if Node on PATH is not a supported version.
# INTERFACE_NODE_BIN=/path/to/node
INTERFACE_BROWSER_HEADLESS=false
INTERFACE_MAX_TOOL_CALLS=40
# Existing PRIVATE S3 bucket. Endpoints are S3 host:port, not console URLs.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_SECURE=true
MINIO_PUBLIC_SECURE=true
MINIO_REGION=us-east-1
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
